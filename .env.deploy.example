# Deployment environment template
# Supply this file outside source control, or use Docker/Kubernetes secrets.
POSTGRES_DB=rptas_treasury
POSTGRES_USER=rptas_runtime
POSTGRES_PASSWORD=
PGRST_DB_URI=postgres://rptas_runtime:<injected-password>@postgres:5432/rptas_treasury

# Frontend build values only; never place database credentials or service-role keys in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

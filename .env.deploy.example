# Copy outside source control. DATABASE_URL is used only by the migration command.
# Supply a percent-encoded Supabase PostgreSQL connection URL from a secret store.
DATABASE_URL=
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Frontend build values only; never place database credentials or service-role keys in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostgreSQL Direct Database Connection (IPv4 compatible via Supabase Pooler)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# =========================================================
# LGU WORKSTATION ACCOUNTS (Reference Accounts)
# Passwords are encrypted as salted Bcrypt hashes in PostgreSQL
# and authenticated via the authenticate_user stored procedure.
# NEVER prefix passwords with VITE_ to prevent bundle leakage.
# =========================================================

# 1. System Administrator (Role: Admin)
# Full system control: User management, AF-51 booklet allocation, COA supervisory voids
# Account: admin@example.com

# 2. Municipal Assessor (Role: Assessor)
# Operational desk: RPTAR masterlist, property assessments, tax calculations, bulk CSV import
# Account: assessor@example.com

# 3. Treasury Viewer (Role: Viewer)
# Read-only executive desk: Executive dashboard, revenue statistics, delinquency lookups
# Account: viewer@example.com
